{
  "name": "travel-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node db/predeploy.js && next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "node --env-file=.env.local db/migrate-pg.js",
    "migrate:prod": "node --env-file=.env.local db/migrate-pg.js --production",
    "migrate:sqlserver-legacy": "node db/migrate.js",
    "db:check": "node --env-file=.env.local db/db-check.js",
    "publish": "node db/publish.js"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "leaflet": "^1.9.4",
    "next": "14.2.35",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
