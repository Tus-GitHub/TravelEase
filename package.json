{
  "name": "travel-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node db/predeploy.js && next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "node --env-file=.env.local db/migrate-pg.js",
    "migrate:prod": "node --env-file=.env.local db/migrate-pg.js --production",
    "migrate:sqlserver-legacy": "node db/migrate.js",
    "seed": "node --experimental-strip-types --env-file=.env.local db/seed-catalog.mjs",
    "seed:prod": "node --experimental-strip-types --env-file=.env.local db/seed-catalog.mjs --production",
    "db:check": "node --env-file=.env.local db/db-check.js",
    "db:check:dev": "node --env-file=.env.local db/check-dev.js",
    "test:drift": "node --test db/tests/schema-drift.test.cjs db/tests/release-replay-proof.test.cjs",
    "test:db": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/db-crud.test.ts",
    "test:pricing": "node --experimental-strip-types db/tests/pricing.test.ts",
    "test:bookings": "node --experimental-strip-types db/tests/bookings.test.ts",
    "test:refund": "node --experimental-strip-types db/tests/refund.test.ts",
    "publish": "node db/publish.js",
    "test:db-hardening": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/db-hardening.test.ts --dev",
    "db:setup-dev-role": "node --experimental-strip-types --env-file=.env.local db/setup-dev-runtime-role.mjs --dev",
    "test:concurrency": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/concurrency.test.ts --dev",
    "test:workflow-races": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/workflow-races.test.ts --dev",
    "test:p1-races": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/p1-races.test.ts --dev",
    "test:content-races": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/content-races.test.ts --dev",
    "test:catalogue-notifications": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/catalogue-notifications.test.ts --dev",
    "test:home-screen": "node db/tests/mobile-home-screen.test.cjs",
    "test:private-quotes": "node db/tests/private-quotes.test.cjs",
    "test:routes": "node --experimental-strip-types db/tests/route-optimization.test.ts && node --experimental-strip-types db/tests/road-matrix.test.ts",
    "test:itineraries": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/itinerary-suggestions.test.ts",
    "test:itinerary-db": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/itinerary-catalogue.test.ts --dev",
    "test:hotels": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/hotels.test.ts",
    "test:hotel-db": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/hotel-destinations.test.ts --dev",
    "test:contact": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/contact.test.ts",
    "test:booking-email": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/booking-email.test.ts",
    "test:booking-contact": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/booking-contact.test.ts",
    "test:booking-contact-db": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/booking-contact-db.mjs --dev",
    "test:login-identifier": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/login-identifier.test.ts",
    "test:vehicle-image": "node --experimental-strip-types --test db/tests/vehicle-image.test.ts",
    "test:loading": "node --experimental-strip-types --import ./db/tests/_register.mjs --test --test-concurrency=1 db/tests/db-pool-lifecycle.test.ts db/tests/cms-read.test.ts",
    "test:contact-db": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/contact-settings.test.ts --dev",
    "test:integration-origins": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/integration-origin-smoke.ts --dev",
    "test:support": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/support-requests.test.ts",
    "test:hotel-enquiry": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/hotel-enquiry-smoke.ts --dev",
    "test:booking-acceptance": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/booking-acceptance.ts --dev",
    "test:auth-acceptance": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/auth-acceptance.ts --dev",
    "test:authgear": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/authgear.test.ts",
    "test:mobile-login": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/mobile-login.test.ts --dev",
    "test:cms": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/cms.test.ts",
    "test:cms-acceptance": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/cms-acceptance.ts --dev",
    "test:weekend": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/weekend-trips.test.ts",
    "test:weekend-admin": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/weekend-admin-acceptance.ts --dev",
    "test:weekend-bookings": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/weekend-bookings.test.ts --dev",
    "test:booking-maps": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/map-services.test.ts",
    "test:car-booking": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/car-booking-acceptance.ts --dev"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@vercel/functions": "3.11.3",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "next": "14.2.35",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.169.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
