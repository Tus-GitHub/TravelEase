{
  "name": "travel-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node db/predeploy.js && next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "node --env-file=.env.local db/migrate-pg.js",
    "migrate:prod": "node --env-file=.env.local db/migrate-pg.js --production",
    "migrate:sqlserver-legacy": "node db/migrate.js",
    "seed": "node --experimental-strip-types --env-file=.env.local db/seed-catalog.mjs",
    "seed:prod": "node --experimental-strip-types --env-file=.env.local db/seed-catalog.mjs --production",
    "db:check": "node --env-file=.env.local db/db-check.js",
    "test:db": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/db-crud.test.ts",
    "test:pricing": "node --experimental-strip-types db/tests/pricing.test.ts",
    "test:bookings": "node --experimental-strip-types db/tests/bookings.test.ts",
    "test:refund": "node --experimental-strip-types db/tests/refund.test.ts",
    "publish": "node db/publish.js",
    "db:check:dev": "node --env-file=.env.local db/check-dev.js",
    "test:drift": "node --test db/tests/schema-drift.test.cjs db/tests/release-replay-proof.test.cjs",
    "db:setup-dev-role": "node --experimental-strip-types --env-file=.env.local db/setup-dev-runtime-role.mjs --dev",
    "test:cms": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/cms.test.ts",
    "test:cms-acceptance": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/cms-acceptance.ts --dev",
    "test:weekend": "node --experimental-strip-types --import ./db/tests/_register.mjs --test db/tests/weekend-trips.test.ts",
    "test:weekend-admin": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/weekend-admin-acceptance.ts --dev",
    "test:weekend-bookings": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/weekend-bookings.test.ts --dev",
    "test:concurrency": "node --experimental-strip-types --import ./db/tests/_register.mjs --env-file=.env.local db/tests/concurrency.test.ts --dev"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "next": "14.2.35",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.169.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
